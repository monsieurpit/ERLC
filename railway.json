{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack pnpm install --no-frozen-lockfile && corepack pnpm --filter @workspace/api-server run build"
  },
  "deploy": {
    "preDeployCommand": "corepack pnpm --filter @workspace/db run push",
    "startCommand": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}